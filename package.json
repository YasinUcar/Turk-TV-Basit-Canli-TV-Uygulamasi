{
  "name": "turk-tv",
  "productName": "Türk TV",
  "version": "1.0.0",
  "description": "Sade ve büyük yazılı Türk canlı TV uygulaması (Windows ve Debian/Ubuntu)",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/hls.js/dist/hls.min.js','hls.min.js')\"",
    "start": "electron .",
    "gen": "python3 gen.py",
    "build:win": "electron-packager . TurkTV --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"node_modules|tr.m3u|logos.csv|gen.py|package-lock.json|dist|packaging|README.md|LICENSE\"",
    "build:linux": "electron-packager . TurkTV --platform=linux --arch=x64 --out=dist --overwrite --ignore=\"node_modules|tr.m3u|logos.csv|gen.py|package-lock.json|dist|packaging|README.md|LICENSE\"",
    "build:deb": "npm run build:linux && sh packaging/build-deb.sh"
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "@electron/packager": "^20.3.0"
  }
}